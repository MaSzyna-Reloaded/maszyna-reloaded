+// Moves the region map's window: it holds the REGION_MAP_SIZE^2 regions around p_region_loc. The
+// active regions must all fit in the new window - unload or remove the others first. The shaders
+// work relative to the window (get_region_map_origin_position()), so it follows a camera that
+// travels far from the world's origin.
+Error Terrain3DData::set_region_map_origin(const Vector2i &p_region_loc) {
+	if (p_region_loc == _region_map_origin) {
+		return OK;
+	}
+	Vector2i old_origin = _region_map_origin;
+	_region_map_origin = p_region_loc;
+	for (int i = 0; i < _region_locations.size(); i++) {
+		Vector2i region_loc = _region_locations[i];
+		if (!is_in_region_map(region_loc)) {
+			LOG(ERROR, "Region ", region_loc, " would be out of the region map around ", p_region_loc,
+				". Max: ", p_region_loc - REGION_MAP_VSIZE / 2, " to ", p_region_loc + REGION_MAP_VSIZE / 2 - V2I(1),
+				". Unload or remove it first");
+			_region_map_origin = old_origin;
+			return FAILED;
+		}
+	}
+	LOG(INFO, "Moving the region map to origin ", p_region_loc);
+	// Only the region map changes, unless rebuilding it reorders the regions' layers
+	TypedArray<Vector2i> old_locations = _region_locations;
+	_region_map_dirty = true;
+	update_maps(TYPE_MAX, false, false);
+	if (_region_locations != old_locations) {
+		update_maps(TYPE_MAX, true, false);
+	}
+	return OK;
+}
+
+// The global position of the region map's window: the corner of its origin region
+Vector3 Terrain3DData::get_region_map_origin_position() const {
+	return Vector3(real_t(_region_map_origin.x) * real_t(_region_size), 0.f,
+				   real_t(_region_map_origin.y) * real_t(_region_size)) *
+		_vertex_spacing;
+}
