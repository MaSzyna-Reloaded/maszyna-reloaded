[gd_scene format=3]

[ext_resource type="Script" path="res://settings/setting_input.gd" id="1_input"]
[ext_resource type="Script" path="res://ui/ui_button.gd" id="ui_button"]
[ext_resource type="Script" path="res://ui/ui_icon_button.gd" id="ui_icon_button"]
[ext_resource type="Texture2D" path="res://ui/trash_icon.svg" id="trash_icon"]

[node name="SettingInput" type="PanelContainer"]
mouse_filter = 1
theme_type_variation = &"SettingItem"
script = ExtResource("1_input")

[node name="Line" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Line"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.5
theme_override_font_sizes/font_size = 16
autowrap_mode = 3

[node name="KeyColumn" type="VBoxContainer" parent="Line"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 0

[node name="KeySlot" type="HBoxContainer" parent="Line/KeyColumn"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Binding" type="Button" parent="Line/KeyColumn/KeySlot"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
focus_mode = 0
mouse_default_cursor_shape = 2
text_overrun_behavior = 3
icon_alignment = 2
script = ExtResource("ui_button")

[node name="ClearKeys" type="Button" parent="Line/KeyColumn/KeySlot"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 0)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Remove binding"
mouse_default_cursor_shape = 2
script = ExtResource("ui_icon_button")
icon = ExtResource("trash_icon")
icon_alignment = 1

[node name="KeyConflict" type="Label" parent="Line/KeyColumn"]
unique_name_in_owner = true
visible = false
layout_mode = 2
auto_translate_mode = 2
theme_override_colors/font_color = Color(0.95, 0.65, 0.18, 1)
theme_override_font_sizes/font_size = 12
autowrap_mode = 3

[node name="PadColumn" type="VBoxContainer" parent="Line"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_constants/separation = 0

[node name="PadSlot" type="HBoxContainer" parent="Line/PadColumn"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 2

[node name="PadBinding" type="Button" parent="Line/PadColumn/PadSlot"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
focus_mode = 0
mouse_default_cursor_shape = 2
text_overrun_behavior = 3
icon_alignment = 1
script = ExtResource("ui_button")

[node name="ClearPad" type="Button" parent="Line/PadColumn/PadSlot"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24, 0)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Remove binding"
mouse_default_cursor_shape = 2
script = ExtResource("ui_icon_button")
icon = ExtResource("trash_icon")
icon_alignment = 1

[node name="PadConflict" type="Label" parent="Line/PadColumn"]
unique_name_in_owner = true
visible = false
layout_mode = 2
auto_translate_mode = 2
theme_override_colors/font_color = Color(0.95, 0.65, 0.18, 1)
theme_override_font_sizes/font_size = 12
autowrap_mode = 3

[node name="UnitColumn" type="Control" parent="Line"]
custom_minimum_size = Vector2(24, 0)
layout_mode = 2
mouse_filter = 2

[node name="ResetColumn" type="Control" parent="Line"]
custom_minimum_size = Vector2(24, 0)
layout_mode = 2
mouse_filter = 2

[connection signal="pressed" from="Line/KeyColumn/KeySlot/Binding" to="." method="wait_for_key"]
[connection signal="pressed" from="Line/KeyColumn/KeySlot/ClearKeys" to="." method="clear_keys"]
[connection signal="pressed" from="Line/PadColumn/PadSlot/PadBinding" to="." method="wait_for_pad"]
[connection signal="pressed" from="Line/PadColumn/PadSlot/ClearPad" to="." method="clear_pad"]
