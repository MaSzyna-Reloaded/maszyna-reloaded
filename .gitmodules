[submodule "vendor/libreloaded"]
	path = vendor/libreloaded
	url = https://github.com/MaSzyna-Reloaded/libreloaded.git
	branch = main
	ignore = untracked
[submodule "vendor/libmaszyna"]
	path = vendor/libmaszyna
	url = https://github.com/MaSzyna-Reloaded/libmaszyna.git
	branch = dev/separate-libmaszyna-rebased
	ignore = untracked
[submodule "vendor/gnd-sfx"]
	path = vendor/gnd-sfx
	url = https://github.com/GamesNotDeveloped/godot-sfx.git
[submodule "vendor/gnd-skydome"]
	path = vendor/gnd-skydome
	url = https://github.com/GamesNotDeveloped/godot-skydome.git
[submodule "vendor/gnd-weather"]
	path = vendor/gnd-weather
	url = git@github.com:GamesNotDeveloped/godot-weather-system.git
[submodule "vendor/gut"]
	path = vendor/gut
	url = https://github.com/bitwes/Gut.git
[submodule "vendor/gnd-biomes"]
	path = vendor/gnd-biomes
	url = https://github.com/GamesNotDeveloped/godot-biomes.git
